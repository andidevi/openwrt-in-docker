[Match]
Name=veth-k3sExtrn-h

[Network]
Description=Host-Anbindung an OpenWrt k3s-Netz (direkt auf veth, ohne Bridge)
# Host bezieht seine Adresse per DHCP vom OpenWrt-Container (dnsmasq auf k3s).
DHCP=yes
IPv6AcceptRA=yes

# keine Route fuer fe80::/64 (mit LinkLocalAddressing=no gibt es ohnehin keins)
LinkLocalAddressing=no

# Keine Default-Routen über dieses Interface in Main: Default bleibt auf veth-mgmt-h.
# Gelernte Routen + explizite Default-Route landen stattdessen in Tabelle 1000,
# Quell-Regeln dafür legt openwrt-netroutes.service zur Laufzeit an.
[DHCPv4]
UseGateway=no

[DHCPv6]
UseGateway=no
RouteTable=1000

[IPv6AcceptRA]
UseGateway=no
RouteTable=1000

# Default-Route in Tabelle 1000 über den RA-advertised Gateway (dynamisch,
# folgt Präfixwechseln ohne Dateiänderung).
[Route]
Gateway=_ipv6ra
Table=1000

# Fängt explizit an das Interface gebundenen Traffic (z.B. ping -I).
[RoutingPolicyRule]
OutgoingInterface=veth-k3sExtrn-h
Priority=200
Table=1000
