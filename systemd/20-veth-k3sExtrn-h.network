[Match]
Name=veth-k3sExtrn-h

[Network]
Description=Host-Anbindung an OpenWrt k3s-Netz (direkt auf veth, ohne Bridge)
# Host bezieht seine Adresse per DHCP vom OpenWrt-Container (dnsmasq auf k3s).
DHCP=yes
IPv6AcceptRA=yes

# keine Route fuer fe80::/64 (mit LinkLocalAddressing=no gibt es ohnehin keins)
LinkLocalAddressing=no

# Gelernte Routen (inkl. RA-Gateway) landen in Tabelle 1000 statt in Main:
# Der Main-Default bleibt dadurch allein auf veth-mgmt-h, k3s-Traffic wird per
# Policy-Regeln (oif-Regel unten + openwrt-netroutes.service) nach 1000 gelenkt.
# WICHTIG: kein explizites [Route] Gateway=_ipv6ra hier — das beißt sich mit
# UseGateway=no (networkd ignoriert die Route dann kommentarlos bzw. beschwert
# sich im Log). Der RA-Gateway kommt über RouteTable= von allein nach 1000.
[DHCPv4]
UseGateway=no

[DHCPv6]
UseGateway=yes
RouteTable=1000

[IPv6AcceptRA]
UseGateway=yes
RouteTable=1000

# Fängt explizit an das Interface gebundenen Traffic (z.B. ping -I).
[RoutingPolicyRule]
OutgoingInterface=veth-k3sExtrn-h
Priority=200
Table=1000
