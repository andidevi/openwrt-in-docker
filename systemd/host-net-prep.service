[Unit]
Description=OpenWrt Host-Netz vorbereiten (Bridges + veth-Paare)
# Kein NetworkManager auf dem Host: alles per ip(8). Idempotent, gefahrlos
# mehrfach startbar (nur anlegen, was fehlt).
Before=openwrt.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/srv/openwrt/sbin/openwrt-net-prep.sh

[Install]
WantedBy=multi-user.target
