[Unit]
Description=OpenWrt Container (docker compose)
# veth-Paare und Adressen kommen deklarativ aus systemd-networkd
# (*.netdev/*.network); keine Prep-Unit nötig.
Requires=docker.service systemd-networkd.service openwrt-modules.service
After=docker.service systemd-networkd.service openwrt-modules.service
Wants=openwrt-netattach.service network-online.target

[Service]
Type=simple
# Eigene Slice: saubere cgroup-Einordnung des Containers unter openwrt.slice.
Slice=openwrt.slice
WorkingDirectory=/srv/openwrt/docker
ExecStart=/usr/bin/docker compose up
# Läuft einmalig nach dem Start und hängt die Interfaces ein.
# Idempotent, Doppellauf mit openwrt-netattach.service ist harmlos.
ExecStartPost=/srv/openwrt/sbin/openwrt-netattach.sh
ExecStop=/usr/bin/docker compose down
# Bewusst kein automatischer Neustart: Stirbt der Container, werden die in
# seine Netns gemovten Interfaces (lan, wan, k3s, mgmt, WLAN-Phy) mit der
# Netns zerstört. Ein blinder Neustart liefe dann ohne Netz. Neustart nur
# manuell (systemctl start openwrt.service), nachdem die veth-Paare wieder
# da sind (networkctl reload legt sie bei Bedarf neu an).
Restart=no
Delegate=yes

[Install]
WantedBy=multi-user.target
