config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan'
	list ports 'lan-opnwrtk3s'
	list ports 'lan-opnwrtmgmt'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
